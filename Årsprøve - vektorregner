def Vektor3Dsum(x1, y1, z1, x2, y2, z2):
    x = x1 + x2 
    y = y1 + y2
    z = z1 + z2

    return(x, y, z)



def Vektor3Dminus(x1, y1, z1, x2, y2, z2):
    x = x1 - x2
