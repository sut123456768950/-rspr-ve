    return(lengde)

def Vektor3Dprikprodukt(x1, y1, x2, y2, z1, z2):
    prikprodukt = (x1 x2) + (y1 * y2) + (z1 * z2)

    return(prikprodukt)

def Vektor3Denhedsvektor(x1, y1, z1):

    enhedsvektorX = x1 / Vektor3Dlengde(x1, y1, z1)
    enhedsvektorY = y1 / Vektor3Dlengde(x1, y1, z1)
